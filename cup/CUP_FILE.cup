/*************/
/* IMPORT(S) */
/*************/
import java_cup.runtime.*;
import ast.*;

parser code
{:
	public Lexer lexer;

	/********************************************************************/
	/* line of the FIRST syntax error encountered, -1 if none yet; read */
	/* by Main to build the ERROR(line) output instead of exiting here  */
	/********************************************************************/
	public int errorLine = -1;

	public Parser(Lexer lexer)
	{
		super(lexer);
		this.lexer = lexer;
	}
	public void report_error(String message, Object info)
	{
		if (errorLine == -1) errorLine = lexer.getLine();
	}
:}

/************************/
/* CUSTOMIZE CUP PARSER */
/************************/
scan with
{:
	Symbol s;
	s = lexer.next_token();
	//System.out.print(s.sym);
	System.out.print("[");
	System.out.print(lexer.getLine());
	System.out.print(":");
	System.out.print(lexer.getTokenStartPosition());
	System.out.print("] ");
	System.out.print(TokenNames.terminalNames[s.sym]);
	if (s.value != null)
	{
		System.out.print("( ");
		System.out.print(s.value);
		System.out.print(" )");
	}
	System.out.print("\n");
	return s; 
:};

/*************/
/* TERMINALS */
/*************/
terminal IF;
terminal ELSE;
terminal RETURN;
terminal EQ;
terminal DOT;
terminal PLUS;
terminal MINUS;
terminal TIMES;
terminal WHILE;
terminal DIVIDE;
terminal LPAREN;
terminal RPAREN;
terminal LBRACK;
terminal RBRACK;
terminal LBRACE;
terminal RBRACE;
terminal SEMICOLON;
terminal ASSIGN;
terminal ARRAY;
terminal CLASS;
terminal EXTENDS;
terminal NEW;
terminal NIL;
terminal TYPE_INT;
terminal TYPE_STRING;
terminal TYPE_VOID;
terminal LT;
terminal GT;
terminal AND;
terminal OR;
terminal COMMA;
terminal String STRING;
terminal ERROR;

/*************/
/* TERMINALS */
/*************/
terminal Integer INT;
terminal String ID;

/*****************/
/* NON TERMINALS */
/*****************/
non terminal AstExp exp;
non terminal AstVar var;
non terminal AstProgram program;
non terminal AstDec dec;
non terminal AstType type;
non terminal AstVarDec varDec;
non terminal AstFuncDec funcDec;
non terminal AstParam param;
non terminal AstParamList paramList;
non terminal AstClassDec classDec;
non terminal AstCfieldList cfieldList;
non terminal AstDec cfield;
non terminal AstDec arrayTypedef;
non terminal AstGeneralExp newExp;     
non terminal AstCallExp callExp;
non terminal AstArgList argList;
non terminal AstStmt stmt;
non terminal AstStmtList stmtList;


/***********************/
/* OPERATOR PRECEDENCE */
/***********************/
  precedence left OR;
  precedence left AND;
  precedence left EQ;
  precedence left LT, GT;
  precedence left PLUS, MINUS;
  precedence left TIMES, DIVIDE;

/************************/
/* START WITH: stmtList */
/************************/
start with program;

/********************/
/* DERIVATION RULES */
/********************/
program     ::=     dec:d                  {: RESULT=new AstProgram(d, dleft+1); :}
			|       program:p dec:d        {: RESULT= p.addPr(d);     	:}
			;
dec 		::= 	varDec:v          		{: RESULT = v; :}
        	| 		funcDec:f          		{: RESULT = f; :}
        	| 		classDec:c        		{: RESULT = c; :}
        	| 		arrayTypedef:a     		{: RESULT = a; :}
			;

type        ::=		TYPE_INT:t				{: RESULT=new AstTypeInt(tleft+1);    :}
			|		TYPE_STRING:t				{: RESULT=new AstTypeString(tleft+1); :}
			|		TYPE_VOID:t				{: RESULT=new AstTypeVoid(tleft+1);   :}
			|		ID:id					{: RESULT=new AstTypeId(id, idleft+1);   :}
        	;

varDec 		::= 	type:t ID:id SEMICOLON					{: RESULT = new AstVarDec(t, id , null, tleft+1); :}
            | 		type:t ID:id ASSIGN exp:e SEMICOLON		{: RESULT = new AstVarDec(t, id , e, tleft+1);    :}
            | 		type:t ID:id ASSIGN newExp:ne SEMICOLON	{: RESULT = new AstVarDec(t, id , ne, tleft+1);   :}
			;

funcDec 	::= 	type:t ID:id LPAREN RPAREN LBRACE stmtList:body RBRACE 				{: RESULT = new AstFuncDec(t, id, null, body, tleft+1); :}
            | 		type:t ID:id LPAREN paramList:p RPAREN LBRACE stmtList:body RBRACE 	{: RESULT = new AstFuncDec(t, id, p, body, tleft+1);    :}
            ;

/* invented: expresses funcDec's {COMMA type ID} repetition, not named in Table 2 */

paramList 	::=  	param:p							{:RESULT=new AstParamList(p, pleft+1);:}
			|		paramList:pl COMMA param:p		{:RESULT=pl.addP(p);		 :}
			;

/* invented: a single "type ID" parameter pair, used inside paramList */

param       ::=  	type:t ID:id 					{:RESULT=new AstParam(t,id, tleft+1); :}
			;

classDec	::=     CLASS:cls	ID:id LBRACE cfieldList:cfl RBRACE            			{: RESULT = new AstClassDec(id,cfl, clsleft+1);      :}
			|		CLASS:cls	ID:id EXTENDS ID:id2 LBRACE cfieldList:cfl RBRACE		{: RESULT = new AstClassDec(id,id2,cfl, clsleft+1);  :}
			;

/* invented: expresses classDec's {cField} repetition, not named in Table 2 */

cfieldList ::=     	cfield:cd     				{: RESULT=new AstCfieldList(cd, cdleft+1); 		:}
			|		cfieldList:cdl cfield:cd	{: RESULT= cdl.addCfield(cd); 	:}
			;


cfield    ::=		varDec:vd          			{: RESULT=vd; :}
			|		funcDec:fd                  {: RESULT=fd; :}
			;

arrayTypedef::=		ARRAY:arr ID:id	EQ type:t LBRACK RBRACK SEMICOLON  {:RESULT= new AstArray(id,t, arrleft+1); :}
			;

newExp      ::=     NEW:nw type:t                          {: RESULT = new AstGeneralExp(t, nwleft+1);   :}
			|       NEW:nw type:t  LBRACK exp:e RBRACK     {: RESULT = new AstGeneralExp(t,e, nwleft+1); :}
			;


callExp 	::= 	ID:id LPAREN RPAREN							{: RESULT = new AstCallExp(null, id, null, idleft+1); :}
            | 		ID:id LPAREN argList:al RPAREN  			{: RESULT = new AstCallExp(null, id, al, idleft+1);   :}
            | 		var:v DOT ID:id LPAREN RPAREN				{: RESULT = new AstCallExp(v, id, null, vleft+1);    :}
            | 		var:v DOT ID:id LPAREN argList:al RPAREN	{: RESULT = new AstCallExp(v, id, al, vleft+1);      :}
            ;   
			
/* invented: expresses callExp's {COMMA exp} repetition, not named in Table 2 */

argList 	::= 	exp:e                     	{: RESULT = new AstArgList(e, eleft+1); :}
            | 		argList:al COMMA exp:e      {: RESULT = al.addArg(e);      :}
            ;


var			::=		ID:name								{: RESULT = new AstVarSimple(name, nameleft+1);       :}
			| 		var:v DOT ID:fieldName				{: RESULT = new AstVarField(v,fieldName, vleft+1); :}
			| 		var:v LBRACK exp:e RBRACK			{: RESULT = new AstVarSubscript(v,e, vleft+1);     :}
			;
					
stmtList	::= 	stmt:s                       {: RESULT = new AstStmtList(s,null, sleft+1); :}
        	| 		stmt:s stmtList:l             {: RESULT = new AstStmtList(s,l, sleft+1);    :}
            ;

stmt 		::= 	varDec:v                                                                								{: RESULT = new AstStmtVarDec(v, vleft+1);               :}
            | 		var:v ASSIGN exp:e SEMICOLON                                             								{: RESULT = new AstStmtAssign(v,e, vleft+1);   			:}
            |		var:v ASSIGN newExp:ne SEMICOLON																		{: RESULT = new AstStmtAssign(v,ne, vleft+1); 			:}
            | 		RETURN:r SEMICOLON                                                       									{: RESULT = new AstStmtReturn(null, rleft+1); 			:}
            | 		RETURN:r exp:e SEMICOLON                                                  								{: RESULT = new AstStmtReturn(e, rleft+1);    			:}
            | 		callExp:c SEMICOLON                                                      								{: RESULT = new AstStmtCall(c, cleft+1);      			:}
            | 		IF:kw LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE													{: RESULT = new AstStmtIf(cond, body, null, kwleft+1); 	:}
            | 		IF:kw LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE ELSE LBRACE stmtList:elseBody RBRACE				{: RESULT = new AstStmtIf(cond, body, elseBody, kwleft+1);:}
            | 		WHILE:w LPAREN exp:cond RPAREN LBRACE stmtList:body RBRACE												{: RESULT = new AstStmtWhile(cond, body, wleft+1); 		:}
			;

exp 		::= 	INT:i                        {: RESULT = new AstExpInt(i, ileft+1);        :}
			|		var:v                        {: RESULT = new AstExpVar(v, vleft+1);        :}
        	| 		exp:e1 PLUS   exp:e2         {: RESULT = new AstExpBinop(e1,e2,0, e1left+1);:}
        	| 		exp:e1 MINUS  exp:e2         {: RESULT = new AstExpBinop(e1,e2,1, e1left+1);:}
			| 		LPAREN exp:e RPAREN          {: RESULT = e;                       :}
        	| 		exp:e1 TIMES  exp:e2         {: RESULT = new AstExpBinop(e1,e2,2, e1left+1);:}
        	| 		exp:e1 DIVIDE exp:e2         {: RESULT = new AstExpBinop(e1,e2,3, e1left+1);:}
        	| 		exp:e1 LT     exp:e2         {: RESULT = new AstExpBinop(e1,e2,4, e1left+1);:}
        	| 		exp:e1 GT     exp:e2         {: RESULT = new AstExpBinop(e1,e2,5, e1left+1);:}
        	| 		exp:e1 EQ     exp:e2         {: RESULT = new AstExpBinop(e1,e2,6, e1left+1);:}
        	| 		exp:e1 AND    exp:e2         {: RESULT = new AstExpBinop(e1,e2,7, e1left+1);:}
        	| 		exp:e1 OR     exp:e2         {: RESULT = new AstExpBinop(e1,e2,8, e1left+1);:}
        	| 		callExp:c                    {: RESULT = c;                       :}
        	| 		MINUS:m INT:i                  {: RESULT = new AstExpInt(-i, mleft+1);       :}
        	| 		NIL:n                          {: RESULT = new AstExpNil(nleft+1);         :}
        	| 		STRING:s                     {: RESULT = new AstExpString(s, sleft+1);     :}
        	;